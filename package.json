{
  "name": "markdownbot-pro",
  "version": "1.0.0",
  "description": "🤖 企業級 Markdown 自動化生成機器人 - 智能模板引擎 + 多場景支援 + CLI 互動界面",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mdbot": "./dist/cli.js",
    "markdownbot": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "markdown",
    "generator",
    "automation",
    "cli",
    "template",
    "documentation",
    "github",
    "bot"
  ],
  "author": "MarkdownBot Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "fs-extra": "^11.2.0",
    "yaml": "^2.3.4",
    "marked": "^11.1.1",
    "validator": "^13.11.0",
    "date-fns": "^3.0.6",
    "figlet": "^1.7.0",
    "boxen": "^7.1.1",
    "cli-table3": "^0.6.3",
    "listr2": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/inquirer": "^9.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/figlet": "^1.5.8",
    "@types/validator": "^13.11.8",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
